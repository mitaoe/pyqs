# Catalog data. The app reads MONGODB_URI at build time (and once a day after
# that) to prerender every subject page.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pyqs

# Without database access, point CATALOG_FILE at a saved copy of the live
# catalog instead (curl -o catalog.json https://mitaoe-pyqs.vercel.app/api/papers).
# CATALOG_FILE=catalog.json

NEXT_PUBLIC_PDF_BASE_URL=https://mitaoe-pyqs.<your-subdomain>.workers.dev
