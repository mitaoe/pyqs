# Copy to .env.local for local use. NEVER commit real values.

# --- Host site (MongoDB) ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pyqs
NEXT_PUBLIC_PDF_BASE_URL=https://mitaoe-pyq-proxy.<your-subdomain>.workers.dev

# --- AI assistant (RAG) ---
# Neon Postgres connection string (pgvector must be available).
# Use the pooled "-pooler" URL on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Comma-separated Gemini free-tier API keys (any count, 1..N). ALL keys are
# shared: the runtime rotates across every key per request (cooldown/bench on
# 429s) and the ingestion pipeline rotates over the same set. One key works;
# more keys raise both quotas.
GEMINI_API_KEYS=your-key-1,your-key-2,your-key-3

# Optional: override the Gemini model used for question extraction.
# Must be a model with free-tier quota (retired models report "limit: 0").
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- Additional LLM providers (optional but recommended) ---
# Runtime LLM traffic is split into two lanes, each with its own fallback
# ladder. Every provider and model below is optional: with only
# GEMINI_API_KEYS set the app works exactly as before.
#
#   classification lane  Groq -> Gemini -> regex-only
#   synthesis lane       Gemini -> Groq -> OpenRouter -> degraded mode
#
# Groq (free tier). One key; console.groq.com/keys
GROQ_API_KEY=your-groq-key
# OpenRouter (free tier). One key; openrouter.ai/keys
# NOTE: the free tier allows 50 free-model requests per DAY (1000 with 10
# credits added). Treat OpenRouter as a thin last resort, not a workhorse.
OPENROUTER_API_KEY=your-openrouter-key

# Lane order — comma-separated provider names (gemini, groq, openrouter).
# Unset uses the defaults above. Remove a name to take that provider out.
# CLASSIFICATION_PROVIDERS=groq,gemini
# SYNTHESIS_PROVIDERS=gemini,groq,openrouter

# Model per provider per lane. Change these WITHOUT a redeploy when a free
# catalogue shifts; a model that 404s aborts its lane loudly rather than
# quietly degrading, and /api/health names it.
# GROQ_CLASSIFICATION_MODEL=openai/gpt-oss-20b
# GROQ_SYNTHESIS_MODEL=openai/gpt-oss-120b
# OPENROUTER_CLASSIFICATION_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_SYNTHESIS_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OpenRouter's free models fail by hanging; cap how long a hang may cost.
# OPENROUTER_TIMEOUT_MS=25000

# --- Shared response cache (Neon) ---
# Deterministic answers (analytics/weightage/trends) are invalidated by the
# corpus_version the ingest workflow bumps; LLM-written answers ride this TTL.
# CACHE_TTL_SEMANTIC_DAYS=7

# Escape hatch: bypass the response cache entirely (both layers).
# RESPONSE_CACHE_DISABLED=1
