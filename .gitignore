# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/logs
/test-results
/playwright-report
/.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.vscode/
.DS_Store
*.pem
.kiro/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (all local variants; keep only the example)
.env
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# Python (RAG ingestion pipeline)
__pycache__/
*.py[cod]
.venv/
venv/

# Downloaded PDFs must never be stored or committed
*.pdf